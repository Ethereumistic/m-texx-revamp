{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets only, on purpose: with no "main" there is no Worker script to invoke, so
  // every request is a free static asset request and none count towards Worker quota.
  "name": "m-texx",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Routes rather than custom domains: the zone's proxied DNS records for these
  // hostnames still name the old Netlify origin, which a custom domain can't replace.
  // The route takes all their traffic, so that origin is never contacted.
  "routes": [
    { "pattern": "m-texx.com/*", "zone_name": "m-texx.com" },
    { "pattern": "www.m-texx.com/*", "zone_name": "m-texx.com" }
  ],
  // Setting routes would otherwise turn this address off.
  "workers_dev": true
}
